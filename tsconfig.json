{
  "exclude": ["dist", "tsup.config.ts"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
