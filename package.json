{
  "name": "create-benguin-app",
  "description": "A custom starter templates",
  "version": "0.1.0",
  "author": "BenguinSan <nguyenthanhphuc311203@gmail.com>",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "bin": {"create-benguin-app": "dist/index.js"},
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benguinsan/create-ben-app.git"
  },
  "homepage": "https://github.com/benguinsan/create-ben-app",
  "keywords": [
    "create-benguin-app",
    "benguin-app-template",
    "benguin-app-templates",
    "benguin-app-templates-cli"
  ],
  "files": [
    "dist",
    "templates"
  ],
  "devDependencies": {
    "@types/node": "^17.0.45",
    "tsup": "^8.5.1",
    "typescript": "^4.9.5"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  }
}
